<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.home-intelligence.healthkit-shortcuts</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__RUN_PATH__</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ORCHESTRATOR_URL</key>
        <string>__ORCHESTRATOR_URL__</string>
        <key>HEALTHKIT_TOKEN</key>
        <string>__HEALTHKIT_TOKEN__</string>
        <key>MEMBER_ID</key>
        <string>__MEMBER_ID__</string>
        <key>SHORTCUT_NAME</key>
        <string>__SHORTCUT_NAME__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>

    <key>StartInterval</key>
    <integer>__INTERVAL_SECONDS__</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/healthkit-shortcuts.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/healthkit-shortcuts.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
