<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>HomeIntelligenceHealth</string>
    <key>CFBundleIdentifier</key>
    <string>com.home-intelligence.healthkit-native</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>HomeIntelligenceHealth</string>
    <key>CFBundleDisplayName</key>
    <string>Home Intelligence Health Sync</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Required by HealthKit. The string is shown to the user in the
         system permission prompt the first time the app calls
         HKHealthStore.requestAuthorization. Be honest and specific. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Home Intelligence Health Sync reads your recent steps, heart rate, sleep, and other Health metrics so they can be forwarded to your local TrueNAS Home Intelligence orchestrator. Data stays on your home network.</string>

    <!-- We do NOT write to HealthKit, only read. NSHealthUpdateUsageDescription
         is intentionally omitted so HealthKit doesn't even ask for write
         permission. -->

    <!-- Background-only utility — no UI. -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
