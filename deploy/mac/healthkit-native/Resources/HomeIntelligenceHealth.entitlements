<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- HealthKit read access — paired with NSHealthShareUsageDescription
         in Info.plist. Without this entitlement, HKHealthStore methods
         return errors. Apple Developer team provisioning required. -->
    <key>com.apple.developer.healthkit</key>
    <true/>

    <!-- Sandbox: enabled for App Store-style hardening. com.apple.security.network.client
         lets the app talk to TrueNAS over the LAN. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
