# === Core ===
# MUST be the absolute host path that contains this repo's infra/ and data/ folders.
# If this path is wrong, Compose GUIs often fail with a generic "Mount path is invalid" error.
HOME_INTEL_DIR=/home/youruser/main/syspool/docker/HomeIntelligence
TZ=Asia/Dubai
COMPOSE_PROJECT_NAME=home-agents

# === Postgres ===
POSTGRES_USER=agents
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=agents
DATABASE_URL=postgresql://agents:changeme-strong-password@postgres:5432/agents

# === Redis ===
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@redis:6379/0

# === Qdrant ===
QDRANT_URL=http://qdrant:6333

# === Ollama (iGPU) ===
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=qwen3:8b
REASONER_MODEL=qwen3.6:35b-a3b

# === Lemonade (NPU) ===
LEMONADE_URL=http://lemonade:8000
ROUTER_MODEL=qwen3-1.7b-int4
EMBED_MODEL=bge-m3-int8
STT_MODEL=distil-whisper-small.en-int8
VISION_MODEL=yolov8n-int8

# === Telegram (rotate before use) ===
TELEGRAM_TOKEN=replace-with-token-from-botfather
TELEGRAM_ALLOWED_USER_IDS=replace-with-your-numeric-id
TELEGRAM_CHAT_ID=replace-with-your-numeric-id

# === Home Assistant ===
HA_URL=http://192.168.1.190:58123
HA_TOKEN=replace-with-long-lived-access-token

# === Home Assistant MCP server ===
# Requires the mcp_server integration to be enabled in HA (Settings → Integrations → Model Context Protocol).
# Defaults to {HA_URL}/mcp_server/sse — override only if your deployment differs.
# HA_MCP_URL=http://192.168.1.190:58123/mcp_server/sse

# === Orchestrator / Agents discovery ===
AGENT_URLS=home_automation=http://home_automation:8000,personal_assistant=http://personal_assistant:8000,system_health=http://system_health:8000,storage_backup=http://storage_backup:8000,knowledge_notes=http://knowledge_notes:8000,household_ops=http://household_ops:8000,entertainment=http://entertainment:8000,dashboard_curator=http://dashboard_curator:8000
ORCHESTRATOR_URL=http://orchestrator:8000

# === Doorbell ===
DOORBELL_ENTITY_ID=camera.front_door

# === Personal Assistant ===
USER_LOCALE=en_AE
USER_TZ=Asia/Dubai

# === Storage & Backup ===
# The Minis Cloud compose file overrides this to /data/media,/data/notes because it mounts only repo-managed folders.
STORAGE_SCAN_ROOTS=/mnt,/host-home

# === Knowledge & Notes ===
NOTES_ROOT=/data/notes

# === Household Operations ===
MEAL_PREFERENCES=halal,no-pork

# === Entertainment ===
MEDIA_LIBRARY_PATH=/data/media
