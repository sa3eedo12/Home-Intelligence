# =============================================================================
# Home-Intelligence on TrueNAS SCALE (Fangtooth 25.04+) Custom Apps
# =============================================================================
# Copy this to deploy/.env and edit before deploying via the Apps GUI.
# Place the .env on the TrueNAS host alongside docker-compose.truenas.yml.
# =============================================================================

# === Core ===
# MUST be the absolute host path of the TrueNAS dataset that holds this repo's
# infra/ and data/ folders. Convention: /mnt/<pool>/AppData/HomeIntelligence
# After creating the dataset, run: chown -R 568:568 ${TRUENAS_APPDATA}
TRUENAS_APPDATA=/mnt/tank/AppData/HomeIntelligence
TZ=Asia/Dubai
COMPOSE_PROJECT_NAME=home-intelligence

# === Postgres ===
POSTGRES_USER=agents
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=agents
DATABASE_URL=postgresql://agents:changeme-strong-password@postgres:5432/agents

# === Redis ===
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@redis:6379/0

# === Qdrant ===
QDRANT_URL=http://qdrant:6333

# === Ollama (Radeon 890M via ROCm) ===
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=qwen3:8b
REASONER_MODEL=qwen3.6:35b-a3b

# === Lemonade (XDNA 2 NPU — DISABLED on TrueNAS) ===
# TrueNAS SCALE 25.10 (Goldeye) does not ship the amdxdna kernel module,
# so /dev/accel/accel0 doesn't exist and the NPU is unavailable. The
# truenas compose file replaces the AMD image with a CPU stub that
# satisfies the /health probe; the small models that would have run on
# the NPU are routed to Ollama (iGPU) via the values below.
LEMONADE_URL=http://lemonade:8000
# Router and embedder served by Ollama on the iGPU instead of the NPU:
ROUTER_MODEL=qwen3:0.6b
EMBED_MODEL=bge-m3
# These two are NPU-only models; they will silently no-op until the NPU
# becomes available. Leave them set so future TrueNAS upgrades pick them up.
STT_MODEL=distil-whisper-small.en-int8
VISION_MODEL=yolov8n-int8

# === Telegram (rotate before use) ===
TELEGRAM_TOKEN=replace-with-token-from-botfather
TELEGRAM_ALLOWED_USER_IDS=replace-with-your-numeric-id
TELEGRAM_CHAT_ID=replace-with-your-numeric-id

# === Home Assistant ===
HA_URL=http://192.168.1.190:58123
HA_TOKEN=replace-with-long-lived-access-token

# === Home Assistant MCP server ===
# HA_MCP_URL=http://192.168.1.190:58123/mcp_server/sse

# === Orchestrator / Agents discovery ===
AGENT_URLS=home_automation=http://home_automation:8000,personal_assistant=http://personal_assistant:8000,system_health=http://system_health:8000,storage_backup=http://storage_backup:8000,knowledge_notes=http://knowledge_notes:8000,household_ops=http://household_ops:8000,entertainment=http://entertainment:8000,dashboard_curator=http://dashboard_curator:8000
ORCHESTRATOR_URL=http://orchestrator:8000

# === Dashboard ===
# Dashboard is exposed at http://<truenas-ip>:8080/dashboard on the LAN.
# To bind to a different host port, change the port mapping in the compose
# file's `orchestrator` service.

# === Doorbell ===
DOORBELL_ENTITY_ID=camera.front_door

# === Personal Assistant ===
USER_LOCALE=en_AE
USER_TZ=Asia/Dubai

# === Storage & Backup ===
# Compose overrides this to /mnt to scan all TrueNAS pools.
STORAGE_SCAN_ROOTS=/mnt

# === Knowledge & Notes ===
NOTES_ROOT=/data/notes

# === Household Operations ===
MEAL_PREFERENCES=halal,no-pork

# === Entertainment ===
MEDIA_LIBRARY_PATH=/data/media
