<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>What I Know · Home Intelligence</title>
  <link rel="stylesheet" href="/static/_design.css">
  <link rel="stylesheet" href="/static/what_i_know.css">
  <script src="/static/_app.js" defer></script>
  <script src="/static/what_i_know.js" defer></script>
</head>
<body>
  <header class="topbar">
    <a href="/dashboard" class="back-link">← Dashboard</a>
    <div>
      <h1>What I Know About You</h1>
      <p>The system's living model of your home and routine.</p>
    </div>
    <button class="btn btn-secondary btn-icon" type="button" data-theme-toggle aria-label="Toggle theme" aria-pressed="false">🌙</button>
  </header>

  {% set summary = summary or {} %}
  {% set household = summary.household or {} %}
  {% set devices = summary.devices or {} %}
  {% set habits = summary.habits or {} %}
  {% set inferences = summary.inferences or {} %}
  {% set observations = summary.observations or {} %}
  {% set health = summary.health or {} %}
  {% set open_questions = summary.open_questions or [] %}
  {% set total_inferences = (inferences.appliance_cycles.total or 0) + (inferences.vacuum_cleanings.total or 0) + (inferences.sleep_summaries.total or 0) + (inferences.presence_returns.total or 0) + (inferences.tv_left_on.total or 0) %}

  <main class="wik-shell stack-lg">

    {# ── Hero strip ────────────────────────────────────────────────── #}
    <section class="metric-strip" aria-label="Snapshot">
      <div class="metric">
        <span class="metric-value">{{ household.members|length if household.members else 0 }}</span>
        <span class="metric-label">People</span>
      </div>
      <div class="metric">
        <span class="metric-value">{{ devices.total or 0 }}</span>
        <span class="metric-label">Devices tracked</span>
      </div>
      <div class="metric">
        <span class="metric-value">{{ habits.confirmed|length if habits.confirmed else 0 }}</span>
        <span class="metric-label">Habits learned</span>
      </div>
      <div class="metric">
        <span class="metric-value">{{ total_inferences }}</span>
        <span class="metric-label">Inferences total</span>
      </div>
      <div class="metric">
        <span class="metric-value">{{ observations.counts_24h_by_kind|length if observations.counts_24h_by_kind else 0 }}</span>
        <span class="metric-label">Active streams (24h)</span>
      </div>
    </section>

    {# ── Open questions (highlighted at top) ─────────────────────── #}
    {% if open_questions %}
    <section class="card stack" aria-label="Open questions">
      <div class="section-header">
        <div>
          <h2>🤔 Things I'm waiting to learn</h2>
          <p>Each one is a quick tap in Telegram or About You.</p>
        </div>
      </div>
      <ul class="kv-list">
        {% for q in open_questions %}
          <li>
            <div class="stack-sm">
              <strong>{{ q.summary }}</strong>
              {% if q.example %}<small class="muted">{{ q.example }}</small>{% endif %}
              {% if q.action %}<small class="muted">{{ q.action }}</small>{% endif %}
            </div>
            <span class="badge badge-{{ q.topic }}">{{ q.topic }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {# ── Household + Devices ─────────────────────────────────────── #}
    <div class="grid-2">
      <section class="card stack">
        <div class="section-header"><div><h2>🏠 Household</h2></div></div>
        {% if household.members %}
          <ul class="kv-list">
            {% for m in household.members %}
              <li>
                <div class="stack-sm">
                  <strong>{{ m.name }} <small class="muted">· {{ m.role }}</small></strong>
                  {% if m.sleep_time or m.wake_time %}
                    <small class="muted">Sleep {{ m.sleep_time or '?' }} · Wake {{ m.wake_time or '?' }}</small>
                  {% endif %}
                  {% if m.allergies %}<small class="muted">Allergies: {{ m.allergies | join(', ') }}</small>{% endif %}
                  {% if m.dietary_restrictions %}<small class="muted">Diet: {{ m.dietary_restrictions | join(', ') }}</small>{% endif %}
                </div>
                {% if m.telegram_chat_id %}<span class="pill pill-success">📱 Telegram</span>{% endif %}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="empty-state-card">
            <span class="empty-state-icon">👥</span>
            <h3>No household members yet</h3>
            <p>Add your first person in <a href="/dashboard/onboarding">Onboarding</a> to start personalizing.</p>
          </div>
        {% endif %}
      </section>

      <section class="card stack">
        <div class="section-header">
          <div>
            <h2>📦 Devices I track</h2>
            <p>{{ devices.total or 0 }} adopted across {{ (devices.by_type or {}) | length }} type(s).</p>
          </div>
          <div class="section-header-actions">
            <a href="/dashboard/devices" class="btn btn-ghost btn-sm">Open Devices →</a>
          </div>
        </div>
        {% if devices.by_type %}
          <ul class="kv-list">
            {% for type, items in devices.by_type | dictsort %}
              <li>
                <span class="kv-key">{{ type }}</span>
                <span class="kv-value">{{ items | length }}</span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="empty-state-card">
            <span class="empty-state-icon">📦</span>
            <h3>No devices identified</h3>
            <p>Adopt your HA entities from <a href="/dashboard/discovery">Discovery</a>.</p>
          </div>
        {% endif %}
      </section>
    </div>

    {# ── Habits + 24h Observations ───────────────────────────────── #}
    <div class="grid-2">
      <section class="card stack">
        <div class="section-header">
          <div>
            <h2>🧠 Habits I've learned</h2>
            <p>{{ habits.confirmed|length if habits.confirmed else 0 }} confirmed · {{ habits.unconfirmed|length if habits.unconfirmed else 0 }} pending.</p>
          </div>
        </div>
        {% if habits.confirmed %}
          <ul class="kv-list">
            {% for h in habits.confirmed[:8] %}
              <li>
                <div class="stack-sm">
                  <strong>{{ h.subject or '—' }}</strong>
                  <small class="muted">{{ h.pattern }}{% if h.frequency %} · {{ h.frequency }}{% endif %}</small>
                </div>
                <span class="pill pill-strong">{{ ((h.confidence or 0) * 100) | round(0) | int }}%</span>
              </li>
            {% endfor %}
          </ul>
          {% if habits.unconfirmed %}
            <details class="disclosure">
              <summary>{{ habits.unconfirmed | length }} unconfirmed candidates</summary>
              <ul class="kv-list">
                {% for h in habits.unconfirmed[:5] %}
                  <li>
                    <span class="kv-key">{{ h.subject or '—' }}</span>
                    <span class="kv-value">{{ h.pattern }}</span>
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        {% else %}
          <div class="empty-state-card">
            <span class="empty-state-icon">🧠</span>
            <h3>No habits learned yet</h3>
            <p>Once observers gather more data, habit candidates appear in <a href="/dashboard/about-you">About You</a> for you to confirm.</p>
          </div>
        {% endif %}
      </section>

      <section class="card stack">
        <div class="section-header"><div><h2>👀 What I've observed (24h)</h2></div></div>
        {% if observations.counts_24h_by_kind %}
          <div class="cluster">
            {% for kind, n in observations.counts_24h_by_kind.items() %}
              <span class="pill pill-strong">{{ kind }} · {{ n }}</span>
            {% endfor %}
          </div>
          {% if observations.recent %}
            <details class="disclosure">
              <summary>Last {{ observations.recent | length }} events</summary>
              <ul class="kv-list">
                {% for e in observations.recent %}
                  <li>
                    <span class="kv-key">{{ e.summary }}</span>
                    <span class="kv-value muted">{{ e.ts[:19] }}</span>
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        {% else %}
          <div class="empty-state-card">
            <span class="empty-state-icon">👀</span>
            <h3>No observer events in the last 24h</h3>
            <p>Observers watch for washer cycles, presence changes, sleep, and more — they'll fill in here as activity happens.</p>
          </div>
        {% endif %}
      </section>
    </div>

    {# ── Recent inferences ──────────────────────────────────────── #}
    <section class="card stack">
      <div class="section-header">
        <div>
          <h2>🔁 Recent inferences</h2>
          <p>What I guessed, and how often you confirmed.</p>
        </div>
      </div>
      <div class="grid-auto">
        {% set sections = [
          ('🧺', 'Appliance cycles', inferences.appliance_cycles, 'guessed_label', 'confirmed_label'),
          ('🧹', 'Vacuum cleanings', inferences.vacuum_cleanings, 'guessed_status', 'confirmed_status'),
          ('🌙', 'Sleep summaries', inferences.sleep_summaries, 'guessed_quality', 'confirmed_quality'),
          ('👋', 'Presence returns', inferences.presence_returns, 'guessed_context', 'confirmed_context'),
          ('📺', 'TV left on', inferences.tv_left_on, 'suggested_action', 'confirmed_action'),
        ] %}
        {% for icon, title, sec, guessed, confirmed in sections %}
          {% set sec = sec or {} %}
          <article class="card stack-sm" style="background: var(--surface-2);">
            <header class="cluster">
              <span style="font-size: 1.2rem;">{{ icon }}</span>
              <strong>{{ title }}</strong>
              <span class="pill pill-strong" style="margin-left: auto;">{{ sec.confirmed or 0 }}/{{ sec.total or 0 }}</span>
            </header>
            {% if sec.recent %}
              <ul class="kv-list">
                {% for r in sec.recent[:4] %}
                  <li>
                    <span class="kv-key">{{ (r.ended_at or r.detected_at or r.returned_at or r.night_of or '') | string | truncate(16, True, '') }}</span>
                    <span class="kv-value">
                      {{ r[guessed] or '?' }}
                      {% if r[confirmed] and r[confirmed] != r[guessed] %}
                        <small class="muted">→ {{ r[confirmed] }}</small>
                      {% elif r[confirmed] %}
                        <span style="color: var(--success);">✓</span>
                      {% endif %}
                    </span>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="muted" style="margin: 0; font-size: var(--font-size-sm);">No data yet</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </section>

    {% set auto = inferences.auto_inferences or {} %}
    {% if auto.recent %}
    <section class="card stack">
      <div class="section-header">
        <div>
          <h2>🤖 Auto-inferences</h2>
          <p>Quick guesses from short events. Confirm or correct in Telegram.</p>
        </div>
      </div>
      <div class="cluster">
        {% for status, n in (auto.by_status or {}).items() %}
          <span class="pill pill-{{ 'success' if status == 'confirmed' else ('info' if status == 'pending' else 'warning') }}">{{ status }} · {{ n }}</span>
        {% endfor %}
      </div>
      <ul class="kv-list">
        {% for ai in auto.recent[:8] %}
          <li>
            <div class="stack-sm">
              <strong>{{ ai.inference }}</strong>
              {% if ai.reasoning %}<small class="muted">{{ ai.reasoning | truncate(120) }}</small>{% endif %}
            </div>
            <span class="pill pill-strong">{{ ((ai.confidence or 0) * 100) | round(0) | int }}%</span>
          </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {# ── Health + What's next ─────────────────────────────────── #}
    <div class="grid-2">
      <section class="card stack">
        <div class="section-header"><div><h2>❤️ Health signal</h2></div></div>
        {% if health.available %}
          <ul class="kv-list">
            <li><span class="kv-key">Last metric</span><span class="kv-value">{{ health.last_metric }}</span></li>
            <li><span class="kv-key">Last value</span><span class="kv-value">{{ health.last_value }}</span></li>
            <li><span class="kv-key">Recorded at</span><span class="kv-value muted">{{ (health.last_ts or '')[:19] }}</span></li>
          </ul>
          <a href="/dashboard/health" class="btn btn-ghost btn-sm">Open Health dashboard →</a>
        {% else %}
          <div class="empty-state-card">
            <span class="empty-state-icon">❤️</span>
            <h3>No HealthKit data yet</h3>
            <p>Set up the iOS Shortcut, the iOS app, or the paid Mac bridge — see <code>deploy/</code>.</p>
          </div>
        {% endif %}
      </section>

      <section class="card stack">
        <div class="section-header"><div><h2>🛠 What's next</h2></div></div>
        <p>The system gets smarter the more you confirm and correct. Each tap on a Telegram quick-reply teaches it your patterns.</p>
        <ul class="kv-list">
          <li><a href="/dashboard/about-you" class="kv-key">About You</a><span class="kv-value muted">confirm habits</span></li>
          <li><a href="/dashboard/morning-brief" class="kv-key">Morning Brief</a><span class="kv-value muted">overnight learnings</span></li>
          <li><a href="/dashboard/discovery" class="kv-key">Discovery</a><span class="kv-value muted">adopt new HA devices</span></li>
          <li><a href="/dashboard/devices" class="kv-key">Devices</a><span class="kv-value muted">browse all</span></li>
        </ul>
      </section>
    </div>

  </main>
</body>
</html>
