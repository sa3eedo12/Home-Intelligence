<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>About You — Home Intelligence</title>
  <link rel="stylesheet" href="/static/_design.css">
  <link rel="stylesheet" href="/static/about_you.css">
  <link rel="stylesheet" href="/static/devices.css">
  <script src="/static/_app.js" defer></script>
  <script src="/static/about_you.js" defer></script>
</head>
<body class="page-body about-you-body">
  {% set current = (knowledge.current_member or {}) %}
  {% set members  = knowledge.members or [] %}
  <header class="topbar">
    <a class="back-link" href="/dashboard">← Dashboard</a>
    <div>
      <h1>About {{ current.name or 'You' }}</h1>
      <p>What Home Intelligence has learned about {{ current.name or 'this person' }} — and the devices they own.</p>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
      {% if members|length > 1 %}
      <select id="member-select" aria-label="Switch household member">
        {% for m in members %}
          <option value="{{ m.id }}" {% if m.id == current.id %}selected{% endif %}>{{ m.name }}</option>
        {% endfor %}
      </select>
      {% endif %}
      <button class="btn btn-secondary btn-icon topbar-theme" type="button" data-theme-toggle aria-label="Toggle theme" aria-pressed="false">🌙</button>
    </div>
  </header>

  {% macro confidence_bar(confidence) -%}
    {% set pct = ((confidence or 0) * 100) | round(0, 'floor') %}
    <div class="confidence" title="confidence {{ pct }}%"><span style="width: {{ pct }}%"></span></div>
    <small>{{ pct }}% confidence</small>
  {%- endmacro %}

  {% macro actions(table, item_id) -%}
    <div class="card-actions">
      <button type="button" class="btn btn-secondary btn-sm edit-btn">✏️ Edit</button>
      <button type="button" class="btn btn-primary btn-sm confirm-btn">✓ Confirm</button>
      <button type="button" class="btn btn-danger btn-sm forget-btn danger">🗑️ Forget</button>
      <button type="button" class="btn btn-ghost btn-sm why-btn linklike">Why?</button>
    </div>
  {%- endmacro %}

  <main>

    <!-- Tabs -->
    <nav class="ay-tabs" role="tablist">
      <button class="ay-tab is-active" data-tab="devices" role="tab">📱 Devices <span class="muted">({{ knowledge.personal_devices|length }})</span></button>
      <button class="ay-tab" data-tab="habits"      role="tab">🔁 Habits <span class="muted">({{ knowledge.habits|length }})</span></button>
      <button class="ay-tab" data-tab="preferences" role="tab">⚙️ Preferences <span class="muted">({{ knowledge.preferences|length }})</span></button>
      <button class="ay-tab" data-tab="routines"    role="tab">🪜 Routines <span class="muted">({{ knowledge.routines|length }})</span></button>
    </nav>

    <!-- Devices tab -->
    <section class="ay-pane is-active" data-pane="devices">
      <div class="card-grid devices-pane">
        {% for item in knowledge.personal_devices %}
          {% set attrs = (item.attributes or {}) %}
          <article class="dev-card device-card" data-thing-id="{{ item.id }}" tabindex="0">
            <div class="dev-card-icon">
              {% set t = item.type or '' %}
              {% if t == 'device.phone' %}📱
              {% elif t == 'device.tablet' %}📱
              {% elif t == 'device.watch' %}⌚
              {% elif t == 'device.laptop' %}💻
              {% elif t == 'device.monitor' %}🖥️
              {% else %}🔌{% endif %}
            </div>
            <p class="dev-card-name">{{ item.friendly_name }}</p>
            <div class="dev-card-meta">
              {% if attrs.manufacturer or attrs.model %}
                <span class="dev-card-pill">{{ (attrs.manufacturer or '') ~ ' ' ~ (attrs.model or '') }}</span>
              {% endif %}
              <span class="dev-card-pill">{{ (item.ha_entity_ids or []) | length }} properties</span>
            </div>
          </article>
        {% else %}
          <div class="empty-state">
            <div class="empty-state-icon">📱</div>
            <h3>No personal devices yet</h3>
            <p>Open <a href="/dashboard/devices">Devices</a>, click any device, and assign it to {{ current.name or 'you' }}.</p>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Habits tab -->
    <section class="ay-pane" data-pane="habits" hidden>
      <div class="card-grid">
        {% for item in knowledge.habits %}
          <article class="knowledge-card card-hover" data-table="habits" data-id="{{ item.id }}">
            <script type="application/json" class="card-json">{{ item | tojson }}</script>
            <header><h3>{{ item.subject }}</h3><span class="badge badge-info">{{ item.frequency or 'observed pattern' }}</span></header>
            <pre>{{ (item.pattern or {}) | tojson }}</pre>
            {{ confidence_bar(item.confidence) }}
            <dl><dt>Source</dt><dd>{{ item.source or 'unknown' }}</dd><dt>Last confirmed</dt><dd>{{ item.last_observed_at or item.created_at or '—' }}</dd></dl>
            {{ actions('habits', item.id) }}
          </article>
        {% else %}
          <div class="empty-state"><div class="empty-state-icon">☕</div><h3>No habits learned yet</h3><p>Morning briefs will surface patterns once observers collect enough evidence.</p></div>
        {% endfor %}
      </div>
    </section>

    <!-- Preferences tab -->
    <section class="ay-pane" data-pane="preferences" hidden>
      <div class="card-grid">
        {% for item in knowledge.preferences %}
          <article class="knowledge-card card-hover" data-table="preferences" data-id="{{ item.key }}">
            <script type="application/json" class="card-json">{{ item | tojson }}</script>
            <header><h3>{{ item.key }}</h3><span class="badge badge-muted">preference</span></header>
            <pre>{{ item.value | tojson }}</pre>
            {{ confidence_bar(item.confidence) }}
            <dl><dt>Source</dt><dd>{{ item.source or 'unknown' }}</dd><dt>Last confirmed</dt><dd>{{ item.updated_at or '—' }}</dd></dl>
            {{ actions('preferences', item.key) }}
          </article>
        {% else %}
          <div class="empty-state"><div class="empty-state-icon">✨</div><h3>No preferences learned yet</h3><p>Answer questions in Morning Brief or Onboarding to teach your defaults.</p></div>
        {% endfor %}
      </div>
    </section>

    <!-- Routines tab -->
    <section class="ay-pane" data-pane="routines" hidden>
      <div class="card-grid">
        {% for item in knowledge.routines %}
          <article class="knowledge-card card-hover" data-table="routines" data-id="{{ item.id }}">
            <script type="application/json" class="card-json">{{ item | tojson }}</script>
            <header><h3>{{ item.name }}</h3><span class="badge badge-success">routine</span></header>
            <pre>{{ {'steps': item.steps, 'schedule': item.schedule} | tojson }}</pre>
            {{ confidence_bar(1.0 if item.last_run_at else 0.5) }}
            <dl><dt>Source</dt><dd>{{ item.source or 'unknown' }}</dd><dt>Last confirmed</dt><dd>{{ item.last_run_at or item.created_at or '—' }}</dd></dl>
            {{ actions('routines', item.id) }}
          </article>
        {% else %}
          <div class="empty-state"><div class="empty-state-icon">🪜</div><h3>No routines learned yet</h3><p>Complete onboarding to seed the first household routines.</p><a class="btn btn-primary btn-sm" href="/dashboard/onboarding">Open Onboarding</a></div>
        {% endfor %}
      </div>
    </section>
  </main>

  <!-- Drill-down panel (same DOM contract as /dashboard/devices) -->
  <aside id="dev-detail" class="dev-detail" hidden aria-label="Device detail">
    <div class="dev-detail-inner">
      <button id="dev-detail-close" class="btn btn-secondary btn-icon" aria-label="Close">✕</button>
      <header class="dev-detail-header">
        <h2 id="dd-name">…</h2>
        <p id="dd-meta" class="muted">…</p>
      </header>
      <section class="dev-detail-section">
        <h3>Properties <small id="dd-entity-count" class="muted"></small></h3>
        <p class="muted dev-detail-hint">Live state from Home Assistant, grouped by category.</p>
        <ul id="dd-entities" class="entity-list"></ul>
      </section>
    </div>
  </aside>

  <dialog id="edit-modal" class="modal">
    <form method="dialog">
      <h2>Edit learned fact</h2>
      <p>Edit JSON fields, then save. Unknown fields are ignored by the server.</p>
      <textarea id="edit-json" class="textarea" spellcheck="false"></textarea>
      <p class="modal-error" id="edit-error" role="alert"></p>
      <menu><button type="button" class="btn btn-secondary" id="cancel-edit">Cancel</button><button type="button" class="btn btn-primary" id="save-edit">Save</button></menu>
    </form>
  </dialog>

  <dialog id="evidence-modal" class="modal">
    <form method="dialog">
      <h2>Why?</h2>
      <div id="evidence-list" class="evidence-list"></div>
      <menu><button type="button" class="btn btn-secondary" id="close-evidence">Close</button></menu>
    </form>
  </dialog>

  <div id="toast-stack" class="toast-stack" aria-live="polite" aria-atomic="false"></div>
</body>
</html>
