# === Core ===
TZ=Asia/Dubai
COMPOSE_PROJECT_NAME=home-agents

# === Postgres ===
POSTGRES_USER=agents
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=agents
DATABASE_URL=postgresql://agents:changeme-strong-password@postgres:5432/agents

# === Redis ===
REDIS_PASSWORD=changeme-redis-password
REDIS_URL=redis://:changeme-redis-password@redis:6379/0

# === Qdrant ===
QDRANT_URL=http://qdrant:6333

# === Ollama (iGPU) ===
OLLAMA_URL=http://ollama:11434
DEFAULT_MODEL=qwen3:8b
# REASONER_MODEL is the nightly-reflector model. qwen3:14b @ ~9 GB resident
# is the recommended sweet spot — real reasoning upgrade over the 8B
# without the MoE/Vulkan deadlock risk of 30B+ models. Set to qwen3:8b
# if you'd rather use one model for everything.
REASONER_MODEL=qwen3:14b
# Default Ollama HTTP timeout in seconds. The nightly reflector now uses
# think=True on the reasoner so individual calls can take 60-300s on
# modest hardware; 600s is the safe ceiling. Bump if you see ReadTimeout
# in /admin/reflection/status's last_error.
OLLAMA_TIMEOUT_SECONDS=300

# === Lemonade (NPU) ===
LEMONADE_URL=http://lemonade:8000
ROUTER_MODEL=qwen3-1.7b-int4
EMBED_MODEL=bge-m3-int8
STT_MODEL=distil-whisper-small.en-int8
VISION_MODEL=yolov8n-int8

# === Telegram (rotate before use) ===
TELEGRAM_TOKEN=replace-with-token-from-botfather
TELEGRAM_ALLOWED_USER_IDS=replace-with-your-numeric-id
TELEGRAM_CHAT_ID=replace-with-your-numeric-id

# === Home Assistant ===
HA_URL=http://192.168.1.190:58123
HA_TOKEN=replace-with-long-lived-access-token
# How many hours of HA history the bridge replays through events.home on
# first start so observers can detect cycles that completed while the
# orchestrator was down. Set to 0 to disable replay.
HA_BRIDGE_REPLAY_HOURS=6
# Optional comma-separated list of HA entity IDs to replay. If empty, the
# bridge fetches /api/states and replays observer-relevant domains
# (sensor, switch, light, climate, vacuum, media_player, etc.).
# HA_BRIDGE_REPLAY_ENTITIES=sensor.washing_machine,sensor.dryer,switch.coffee_machine

# === Home Assistant MCP server ===
# Requires the mcp_server integration to be enabled in HA (Settings → Integrations → Model Context Protocol).
# Defaults to {HA_URL}/mcp_server/sse — override only if your deployment differs.
# HA_MCP_URL=http://192.168.1.190:58123/mcp_server/sse

# === Orchestrator / Agents discovery ===
AGENT_URLS=home_automation=http://home_automation:8000,personal_assistant=http://personal_assistant:8000,system_health=http://system_health:8000,storage_backup=http://storage_backup:8000,knowledge_notes=http://knowledge_notes:8000,household_ops=http://household_ops:8000,entertainment=http://entertainment:8000,dashboard_curator=http://dashboard_curator:8000
ORCHESTRATOR_URL=http://orchestrator:8000

# === Reflection dev-delivery (Chapter 6) ===
# Fine-grained PAT with issues:write and actions:write on this repo only.
GITHUB_REPO_TOKEN=
GITHUB_REPO=sa3eedo12/Home-Intelligence

# === Doorbell ===
DOORBELL_ENTITY_ID=camera.front_door

# === Personal Assistant ===
USER_LOCALE=en_AE
USER_TZ=Asia/Dubai
MORNING_BRIEF_HOUR=07:30
# MORNING_BRIEF_TZ defaults to TZ when unset.

# === Storage & Backup ===
STORAGE_SCAN_ROOTS=/mnt,/host-home

# === Knowledge & Notes ===
NOTES_ROOT=/data/notes

# === Household Operations ===
MEAL_PREFERENCES=halal,no-pork

# === Entertainment ===
MEDIA_LIBRARY_PATH=/data/media

# === Data science (Chapter 5) ===
# Where weekly/monthly reports + LoRA training files go.
# In the truenas compose these are bind-mounted from ${TRUENAS_APPDATA}/data/{reports,lora}.
REPORTS_DIR=/data/reports
LORA_DATA_DIR=/data/lora

# === Apple Health (Chapter 11) ===
# Long random string. The iOS Health Auto Export app must send this in the
# X-Health-Token header. Generate with: openssl rand -hex 32
HEALTHKIT_WEBHOOK_TOKEN=
